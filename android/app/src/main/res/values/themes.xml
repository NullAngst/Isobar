<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight plus isLightTheme, so the WebView's prefers-color-scheme follows the
         phone's dark mode. That's what Isobar's "System" theme reads. -->
    <style name="Theme.Isobar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/isobar_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:isLightTheme" tools:targetApi="29">true</item>
    </style>
</resources>
