# Isobar Server settings. Copy this file to .env next to compose.yml and fill
# in the first two. Everything else has a working default. In Portainer, add
# these under the stack's environment variables instead.

# --- Required -------------------------------------------------------------

# Your email address. The NWS requires a contact in every request's
# User-Agent, and uses it if the server ever misbehaves.
CONTACT_EMAIL=

# The name the Isobar app shows for this server (Settings, Servers, Test).
SERVER_LABEL=Isobar Server

# --- Access ---------------------------------------------------------------

# The key file on this machine. ./keys.txt works with docker compose run
# from this folder. In Portainer, use the absolute path, like /opt/isobar/keys.txt.
KEYS_PATH=./keys.txt

# Where the relay reads the keys inside the container. Leave it unless you
# change the mount in compose.yml.
KEYS_FILE=/config/keys.txt

# Host port your HTTPS proxy forwards to. Don't expose it to the internet
# directly; only the proxy should reach it.
RELAY_PORT=8787

# true: anything that didn't arrive over HTTPS (per the proxy's
# X-Forwarded-Proto header) gets no answer. Set false only for a server
# reached on your LAN alone. NEVER PUT THE RELAY ON THE INTERNET WITHOUT HTTPS.
REQUIRE_HTTPS=true

# Requests per minute per key. A minute's worth can come in a burst.
RATE_LIMIT_PER_KEY=300

# Wrong-key attempts per address in 10 minutes before that address gets no
# answer for an hour, right key or not.
AUTH_FAIL_LIMIT=20

# How long a request that gets no answer is held open before it's closed.
SILENT_HOLD_SECONDS=30

# Most connections held open at once. Past it, new ones close at once,
# still without a byte.
SILENT_HOLD_MAX=200

# --- Optional parts -------------------------------------------------------

# MRMS fallback radar. false on a box with a weak CPU or upload; another
# server in your users' lists can carry radar instead.
ENABLE_RADAR=true

# Zoom levels the radar tiles are cut at. If the log says rendering takes
# longer than 2 minutes, use 3-7.
RADAR_ZOOMS=3-8

# NWWS-OI credentials from the NWS. Empty means off. Request them on day one:
# approval can take 10 days or more, and everything else works without them.
NWWS_USER=
NWWS_PASS=

# --- Forecast models ------------------------------------------------------

# The short-range model for current conditions and the next 48 hours.
# ncep_hrrr_conus is HRRR. If HRRR stops updating (NOAA is moving to RRFS),
# set ncep_rrfs_conus here and run docker compose up -d. maintenance.md has
# the check.
SHORT_RANGE_MODEL=ncep_hrrr_conus

# Weather variables the sync workers download, by Open-Meteo's stored names.
# The default covers every field the Isobar app asks for. Add a name here if
# a field comes back empty; each one costs disk.
#OM_VARIABLES=static,temperature_2m,relative_humidity_2m,precipitation,showers,snowfall,snowfall_water_equivalent,frozen_precipitation_percent,cloud_cover,pressure_msl,wind_u_component_10m,wind_v_component_10m,wind_speed_10m,wind_direction_10m,wind_gusts_10m,visibility,uv_index,uv_index_clear_sky,cape,lifted_index,convective_inhibition,categorical_freezing_rain,boundary_layer_height,shortwave_radiation,diffuse_radiation,precipitation_probability

# Air quality variables from CAMS.
#OM_AIR_VARIABLES=static,pm10,pm2_5,carbon_monoxide,nitrogen_dioxide,sulphur_dioxide,ozone
